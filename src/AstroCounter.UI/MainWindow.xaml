<Window x:Class="AstroCounter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AstroCounter.UI.ViewModels"
        mc:Ignorable="d"
        Title="AstroCounter - Astrofotoğraflarda Yapay Zeka ile Nesne Tespiti ve Sayımı"
        Height="850" Width="1350"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0A0D14"
        Foreground="#ECEFF4"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Modern Glow & Rounded Card Styles -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#121824"/>
            <Setter Property="BorderBrush" Value="#222C3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Top Controls -->
            <RowDefinition Height="Auto"/> <!-- Metrics & Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Canvas / Interactive Image Viewer -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Title & Actions -->
        <Border Grid.Row="0" Background="#0F141F" BorderBrush="#1E2638" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="20" Foreground="#00E5FF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="AstroCounter" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#162E4A" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="YOLO + SAHI + DirectML" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <!-- Center Engine Mode & Hardware Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Engine Mode Switcher -->
                    <Border Background="#161E2E" CornerRadius="8" Padding="6,3" Margin="0,0,14,0" BorderBrush="#222C3D" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="🔭 Astronomik Fotometri"
                                         IsChecked="{Binding IsPhotometricMode}"
                                         Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"
                                         Margin="4,0,8,0" VerticalAlignment="Center"/>
                            <RadioButton Content="🧠 YOLO Yapay Zeka"
                                         IsChecked="{Binding IsYoloMode}"
                                         Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11"
                                         VerticalAlignment="Center"/>
                            <Button Content="📂 Model Seç..."
                                    Command="{Binding SelectCustomModelCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    FontSize="9" Padding="6,2" Margin="8,0,0,0"
                                    Visibility="{Binding IsYoloMode, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Motor: " Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="12" Padding="8,3" Margin="4,0,0,0">
                        <TextBlock Text="{Binding HardwareInfo}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </StackPanel>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁 Görsel Seç" Command="{Binding SelectImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="⚡ Yeniden Analiz Et" Command="{Binding AnalyzeCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="📊 CSV Dışa Aktar" Command="{Binding ExportCsvCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="💾 Görseli Kaydet" Command="{Binding ExportImageCommand}" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- METRICS & SLIDER BAR -->
        <Border Grid.Row="1" Background="#0C101A" BorderBrush="#1A2233" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Stat Cards -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Count -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TOPLAM OBJE" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tier 1 High -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TIER 1 (YÜKSEK >10σ)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Tier1Count}" FontSize="22" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tier 2 Medium -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TIER 2 (ORTA 5-10σ)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Tier2Count}" FontSize="22" FontWeight="Bold" Foreground="#FFD600" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tier 3 Low -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="TIER 3 (DÜŞÜK 3-5σ)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Tier3Count}" FontSize="22" FontWeight="Bold" Foreground="#FF9100" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Time & Tiles -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="İŞLEM SÜRESİ" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ProcessingTimeText}" FontSize="18" FontWeight="Bold" Foreground="#E2E8F0"/>
                                <TextBlock Text="{Binding TileCountText, StringFormat=' ({0})'}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Interactive Confidence Slider -->
                <Border Grid.Column="1" Background="#121824" BorderBrush="#222C3D" BorderThickness="1" CornerRadius="8" Padding="16,8" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Slider Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Canlı Güven Eşiği (Confidence Filter): " FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                            <TextBlock Text="{Binding ConfidencePercentText}" FontSize="12" FontWeight="Bold" Foreground="#00E5FF"/>
                            <TextBlock Text=" (Re-inference gerektirmez)" FontSize="11" Foreground="#64748B" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Toggles -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding ShowBoundingBoxes}" Content="Kutular" Foreground="#94A3B8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding ShowLabels}" Content="Etiketler" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Slider -->
                        <Slider Grid.Row="1" Grid.ColumnSpan="2"
                                Minimum="0.10" Maximum="0.90"
                                Value="{Binding ConfidenceThreshold, Mode=TwoWay}"
                                SmallChange="0.01" LargeChange="0.05"
                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN INTERACTIVE VIEWER (PAN & ZOOM) -->
        <ScrollViewer Grid.Row="2"
                      x:Name="ViewerScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#070A0F"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      PreviewMouseDown="ScrollViewer_PreviewMouseDown"
                      PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                      PreviewMouseUp="ScrollViewer_PreviewMouseUp">

            <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                </Grid.LayoutTransform>

                <!-- Empty State Placeholder when no image loaded -->
                <Border x:Name="PlaceholderBorder"
                        Width="800" Height="500"
                        BorderBrush="#1E293B" BorderThickness="2"
                        CornerRadius="12"
                        Background="#0D131F"
                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🔭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="Astrofotoğrafınızı Buraya Sürükleyip Bırakın" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="TIFF, PNG, JPG, BMP veya 16-bit FITS formatları desteklenir" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,20"/>
                        <Button Content="Gözat ve Görsel Seç" Command="{Binding SelectImageCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Astro Image -->
                <Image x:Name="AstroImage"
                       Source="{Binding ImageBitmap}"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Overlaid Bounding Box Canvas -->
                <ItemsControl ItemsSource="{Binding VisibleBoxes}"
                              Width="{Binding ImageWidth}"
                              Height="{Binding ImageHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding TooltipText}">
                                <!-- Bounding Box Border -->
                                <Rectangle Width="{Binding Width}"
                                           Height="{Binding Height}"
                                           Stroke="{Binding ColorHex}"
                                           StrokeThickness="1.5"/>

                                <!-- Small Badge Label -->
                                <Border Background="#D00F172A"
                                        CornerRadius="2"
                                        Padding="3,1"
                                        Margin="0,-16,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LabelText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding ColorHex}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#0A0E17" BorderBrush="#1A2233" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>

                <!-- Zoom Level -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Yakınlaştırma: " Foreground="#64748B" FontSize="11"/>
                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                    <Button Content="Sıfırla" Click="ResetZoom_Click" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Margin="8,0,0,0" FontSize="10"/>
                </StackPanel>

                <!-- Progress Bar -->
                <ProgressBar Grid.Column="2"
                             Height="8"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             Foreground="#00E5FF"
                             Background="#1E293B"
                             BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
