<Window x:Class="AstroCounter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AstroCounter.UI.ViewModels"
        xmlns:local="clr-namespace:AstroCounter.UI"
        mc:Ignorable="d"
        Title="{Binding L_WindowTitle}"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Height="880" Width="1400"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0A0D14"
        Foreground="#ECEFF4"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#059669"/>
        <SolidColorBrush x:Key="RedBrush" Color="#DC2626"/>

        <!-- Modern Glow & Rounded Card Styles -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#121824"/>
            <Setter Property="BorderBrush" Value="#222C3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Toolbar chip-style radio buttons (checked colour comes from the Tag brush) -->
        <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Tag" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip"
                                Background="#1A2233"
                                BorderBrush="#2A364D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chip" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- Custom Confidence Slider with Dynamic Color Binding -->
        <Style x:Key="ConfidenceSliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="22" Height="22">
                            <!-- Outer glow halo using ConfidenceBrush -->
                            <Ellipse Width="22" Height="22" Fill="{Binding ConfidenceBrush}" Opacity="0.35"/>
                            <!-- Inner indicator circle -->
                            <Ellipse Width="14" Height="14" Fill="{Binding ConfidenceBrush}" Stroke="#FFFFFF" StrokeThickness="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfidenceSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Groove / Background track -->
                            <Border Height="6" CornerRadius="3" Background="#1E293B" Margin="7,0"/>

                            <!-- Active track and draggable thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{Binding ConfidenceBrush}" Margin="7,0,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ConfidenceSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E3A5F"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#162E4A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#1E293B"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#94A3B8"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#283548"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#475569"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#162032"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#ECEFF4"/>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Margin="10,3,24,3"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#0F172A"
                                            BorderBrush="#334155"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0"
                                            Padding="2">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PlaceholderText" Property="Foreground" Value="#64748B"/>
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Top Controls -->
            <RowDefinition Height="Auto"/> <!-- Engine and scan-area toolbar -->
            <RowDefinition Height="Auto"/> <!-- Metrics & Filter Bar -->
            <RowDefinition Height="*"/>    <!-- Canvas / Interactive Image Viewer -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP BAR: Title & Actions -->
        <Border Grid.Row="0" Background="#0F141F" BorderBrush="#1E2638" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AstroCounter" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Border Background="#162E4A" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L_HeaderSubtitle}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>

                <!-- Right Action Buttons + Language Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding LanguageButtonText}"
                            Command="{Binding ToggleLanguageCommand}"
                            ToolTip="{Binding L_LanguageToolTip}"
                            Style="{StaticResource ModernButtonStyle}"
                            FontSize="11"
                            Padding="10,6"
                            Margin="0,0,12,0"/>
                    <Button Content="{Binding L_SelectImage}" Command="{Binding SelectImageCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="{Binding L_Reanalyze}" Command="{Binding AnalyzeCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="{Binding L_ExportCsv}" Command="{Binding ExportCsvCommand}" Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="{Binding L_ExportImage}" Command="{Binding ExportImageCommand}" Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR: Engine mode and scan-area tools (wraps instead of overlapping on narrow windows) -->
        <Border Grid.Row="1" Background="#0D1220" BorderBrush="#1A2233" BorderThickness="0,0,0,1" Padding="20,8">
            <WrapPanel Orientation="Horizontal">

                <!-- Engine Mode Switcher and Hardware Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,28,3">
                    <TextBlock Text="{Binding L_EngineGroup}" Style="{StaticResource GroupLabelStyle}"/>
                    <RadioButton GroupName="EngineMode" Content="{Binding L_Photometry}"
                                 IsChecked="{Binding IsPhotometricMode}"
                                 Style="{StaticResource ChipRadioStyle}"/>
                    <RadioButton GroupName="EngineMode" Content="{Binding L_Yolo}"
                                 IsChecked="{Binding IsYoloMode}"
                                 Style="{StaticResource ChipRadioStyle}"/>
                    <Button Content="{Binding L_SelectModel}"
                            Command="{Binding SelectCustomModelCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            FontSize="11" Padding="8,4" Margin="2,0,8,0"
                            Visibility="{Binding IsYoloMode, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="#1E293B" CornerRadius="12" Padding="8,3" Margin="6,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HardwareInfo}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <CheckBox IsChecked="{Binding IsAutoBrightnessEnabled, Mode=TwoWay}"
                              Content="{Binding BrightnessStatusText}"
                              Foreground="#FBBF24"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="4,0,0,0"
                              ToolTip="{Binding L_AutoBrightnessToolTip}"/>
                </StackPanel>

                <!-- Scan area (region of interest) tools -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                    <TextBlock Text="{Binding L_ScanAreaGroup}" Style="{StaticResource GroupLabelStyle}"/>
                    <RadioButton GroupName="ScanTool" Content="{Binding L_Pan}"
                                 IsChecked="{Binding IsToolPan}"
                                 Style="{StaticResource ChipRadioStyle}"/>
                    <RadioButton GroupName="ScanTool" Content="{Binding L_Rectangle}"
                                 IsChecked="{Binding IsToolRectangle}"
                                 Style="{StaticResource ChipRadioStyle}"/>
                    <RadioButton GroupName="ScanTool" Content="{Binding L_Polygon}"
                                 IsChecked="{Binding IsToolPolygon}"
                                 Style="{StaticResource ChipRadioStyle}"/>

                    <Border Width="1" Height="22" Background="#2A364D" Margin="8,0,12,0"/>

                    <RadioButton GroupName="RegionMode" Content="{Binding L_Exclude}"
                                 IsChecked="{Binding IsExcludeMode}"
                                 Tag="{StaticResource RedBrush}"
                                 Style="{StaticResource ChipRadioStyle}"/>
                    <RadioButton GroupName="RegionMode" Content="{Binding L_Include}"
                                 IsChecked="{Binding IsIncludeMode}"
                                 Tag="{StaticResource GreenBrush}"
                                 Style="{StaticResource ChipRadioStyle}"/>

                    <Button Content="{Binding L_Undo}" Command="{Binding UndoRegionCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            FontSize="11" Padding="8,4" Margin="8,0,4,0"/>
                    <Button Content="{Binding L_Clear}" Command="{Binding ClearRegionsCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            FontSize="11" Padding="8,4" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ToolHint}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Width="1" Height="22" Background="#2A364D" Margin="14,0,14,0" VerticalAlignment="Center"/>

                <!-- Stellarium & Astrometry Synchronization (WrapPanel so it always fits on screen) -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                    <TextBlock Text="{Binding L_StellariumGroup}" Style="{StaticResource GroupLabelStyle}"/>

                    <!-- Stellarium Connection Toggle Button -->
                    <Button Command="{Binding ToggleStellariumCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            FontSize="11" Padding="10,4" Margin="0,2,6,2">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStellariumConnected}" Value="True">
                                                <Setter Property="Fill" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StellariumStatusText}"/>
                        </StackPanel>
                    </Button>

                    <!-- Star-Pattern Automatic Astrometry Solve Button -->
                    <Button Command="{Binding PlateSolveCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            ToolTip="{Binding L_PlateSolveToolTip}"
                            FontSize="11" Padding="10,4" Margin="0,2,6,2">
                        <TextBlock Text="{Binding L_PlateSolveButton}"/>
                    </Button>

                    <!-- Target Selection ComboBox (Only lists celestial objects inside the current photo's field of view) -->
                    <ComboBox ItemsSource="{Binding AvailableTargetsInPhoto}"
                              SelectedItem="{Binding SelectedCatalogueTarget, Mode=TwoWay}"
                              IsEnabled="{Binding HasTargetsInPhoto}"
                              Tag="{Binding TargetComboPlaceholderText}"
                              DisplayMemberPath="CommonName"
                              Style="{StaticResource DarkComboBoxStyle}"
                              Width="225"
                              Height="26"
                              MaxDropDownHeight="320"
                              VerticalAlignment="Center"
                              Margin="0,2,8,2"
                              ToolTip="{Binding L_TargetComboToolTip}"/>

                    <!-- Live Two-Way 1:1 Sync CheckBox (Pan + Zoom + Angle) -->
                    <CheckBox IsChecked="{Binding IsStellariumSyncEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding IsStellariumConnected}"
                              Content="{Binding L_TwoWaySync}"
                              Foreground="#94A3B8"
                              VerticalAlignment="Center"
                              Margin="2,2,10,2"
                              ToolTip="{Binding L_TwoWaySyncToolTip}"/>

                    <!-- Spherical Grid Overlay Toggle -->
                    <CheckBox IsChecked="{Binding ShowSphericalGrid, Mode=TwoWay}"
                              Content="{Binding L_SphericalGrid}"
                              Foreground="#94A3B8"
                              VerticalAlignment="Center"
                              Margin="0,2,10,2"
                              ToolTip="{Binding L_SphericalGridToolTip}"/>

                    <!-- Single Manual 0°-360° Angle Slider -->
                    <Border Background="#162032" BorderBrush="#2A364D" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,2,8,2"
                            ToolTip="{Binding L_AngleToolTip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_AngleLabel}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider Minimum="0" Maximum="360"
                                    Value="{Binding ImageRotationAngle, Mode=TwoWay}"
                                    Width="110"
                                    SmallChange="1" LargeChange="15"
                                    TickFrequency="1" IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ImageRotationAngle, StringFormat='{}{0:F0}°'}"
                                       Width="34" TextAlignment="Right"
                                       Foreground="#38BDF8" FontWeight="Bold" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <Button Content="↺" Command="{Binding ResetRotationCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="5,1" FontSize="11"
                                    ToolTip="{Binding L_ResetAngleToolTip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Solved Target Coordinates Pill -->
                    <Border Background="#162E4A" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,2,0,2"
                            Visibility="{Binding IsWcsAvailable, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding TargetDetailsText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SolvedCoordinatesText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Distortion / Diagnostic Warning Badge -->
                    <Border Background="#2D1B04" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="6,2,0,2"
                            Visibility="{Binding HasDiagnosticWarning, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding DiagnosticWarningText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DiagnosticWarningText}" Foreground="#FBBF24" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!-- METRICS & SLIDER BAR -->
        <Border Grid.Row="2" Background="#0C101A" BorderBrush="#1A2233" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Stat Cards with horizontal scrolling fallback if screen is narrow -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total Count -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding L_TotalObjects}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tier 1 High -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TIER 1 (&gt;10σ)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Tier1Count}" FontSize="20" FontWeight="Bold" Foreground="#00E676" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tier 2 Medium -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TIER 2 (5-10σ)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Tier2Count}" FontSize="20" FontWeight="Bold" Foreground="#FFD600" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Tier 3 Low -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="TIER 3 (3-5σ)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Tier3Count}" FontSize="20" FontWeight="Bold" Foreground="#FF9100" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Speculative / Noise Risk (<3σ) -->
                        <Border Style="{StaticResource MetricCardStyle}"
                                Visibility="{Binding HasSpeculativeObjects, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#EF4444">
                            <StackPanel>
                                <TextBlock Text="{Binding L_Speculative}" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444"/>
                                <TextBlock Text="{Binding SpeculativeCount}" FontSize="20" FontWeight="Bold" Foreground="#EF4444" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Scan area summary -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding L_ScanAreaGroup}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock Text="{Binding RegionSummary}" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Time & Tiles -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding L_ProcessingTime}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ProcessingTimeText}" FontSize="18" FontWeight="Bold" Foreground="#E2E8F0"/>
                                    <TextBlock Text="{Binding TileCountText, StringFormat=' ({0})'}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Interactive Confidence Slider with Fixed Invariant Width (Never shrinks or resizes) -->
                <Border Grid.Column="1" Width="390" Background="#121824" BorderBrush="{Binding ConfidenceBrush}" BorderThickness="1.2" CornerRadius="8" Padding="14,8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Slider Header -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_ConfidenceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                            <TextBlock Text="{Binding ConfidencePercentText}" FontSize="13" FontWeight="Bold" Foreground="{Binding ConfidenceBrush}"/>
                            <Border Background="#1E293B" CornerRadius="10" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConfidenceStatusText}" Foreground="{Binding ConfidenceBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Toggles -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding ShowBoundingBoxes}" Content="{Binding L_Boxes}" Foreground="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding ShowLabels}" Content="{Binding L_Labels}" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Slider with Dynamic Color (Red <15%, Yellow 15-25%, Cyan >=25%) -->
                        <Slider Grid.Row="1" Grid.ColumnSpan="2"
                                Style="{StaticResource ConfidenceSliderStyle}"
                                Minimum="0.01" Maximum="0.99"
                                Value="{Binding ConfidenceThreshold, Mode=TwoWay}"
                                SmallChange="0.01" LargeChange="0.05"
                                TickFrequency="0.05" IsSnapToTickEnabled="False"
                                Margin="0,10,0,2"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN INTERACTIVE VIEWER (PAN & ZOOM) -->
        <ScrollViewer Grid.Row="3"
                      x:Name="ViewerScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#070A0F"
                      ScrollChanged="ViewerScrollViewer_ScrollChanged"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      PreviewMouseDown="ScrollViewer_PreviewMouseDown"
                      PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                      PreviewMouseUp="ScrollViewer_PreviewMouseUp">

            <Grid x:Name="CanvasContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                        <RotateTransform x:Name="CanvasRotate" Angle="{Binding ImageRotationAngle}"/>
                    </TransformGroup>
                </Grid.LayoutTransform>

                <!-- Empty State Placeholder when no image loaded -->
                <Border x:Name="PlaceholderBorder"
                        Width="800" Height="500"
                        BorderBrush="#1E293B" BorderThickness="2"
                        CornerRadius="12"
                        Background="#0D131F"
                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding L_PlaceholderTitle}" FontSize="18" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding L_PlaceholderFormats}" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,20"/>
                        <Button Content="{Binding L_PlaceholderBrowse}" Command="{Binding SelectImageCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="ImageSurface">
                    <!-- Astro Image: sized in image PIXELS (not DIPs) so it always lines up with the detections -->
                    <Image x:Name="AstroImage"
                           Source="{Binding ImageBitmap}"
                           Width="{Binding ImageWidth}"
                           Height="{Binding ImageHeight}"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Overlaid detections and scan regions (drawn with a DrawingContext for speed) -->
                    <local:DetectionOverlay x:Name="Overlay"
                                            Width="{Binding ImageWidth}"
                                            Height="{Binding ImageHeight}"
                                            Objects="{Binding VisibleObjects}"
                                            Regions="{Binding RegionSnapshot}"
                                            ShowBoxes="{Binding ShowBoundingBoxes}"
                                            ShowLabels="{Binding ShowLabels}"
                                            ShowSphericalGrid="{Binding ShowSphericalGrid}"
                                            Wcs="{Binding CurrentWcs}"
                                            TargetMarkerPixel="{Binding TargetMarkerPixel}"
                                            TargetMarkerLabel="{Binding TargetMarkerLabel}"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#0A0E17" BorderBrush="#1A2233" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <!-- Status Text -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Cursor Celestial Coordinates -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding L_CursorLabel}" Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding CursorCelestialText}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Zoom Level -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding L_ZoomLabel}" Foreground="#64748B" FontSize="11"/>
                    <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                    <Button Content="{Binding L_FitButton}" Click="FitZoom_Click" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Margin="8,0,0,0" FontSize="10"/>
                    <Button Content="100%" Click="ResetZoom_Click" Style="{StaticResource ModernButtonStyle}" Padding="6,2" Margin="4,0,0,0" FontSize="10"/>
                </StackPanel>

                <!-- Progress Bar -->
                <ProgressBar Grid.Column="3"
                             Height="8"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             Foreground="#00E5FF"
                             Background="#1E293B"
                             BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
