<Window x:Class="AstroCounter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AstroCounter.UI.ViewModels"
        xmlns:local="clr-namespace:AstroCounter.UI"
        mc:Ignorable="d"
        Title="{Binding L_WindowTitle}"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Height="900" Width="1440"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#04070E"
        Foreground="#F1F5F9"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Observatory Core Brushes -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#059669"/>
        <SolidColorBrush x:Key="RedBrush" Color="#E11D48"/>

        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0EA5E9" Offset="0.0"/>
            <GradientStop Color="#0284C7" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F60B1221" Offset="0.0"/>
            <GradientStop Color="#F2080E1A" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Minimalist ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Background="#2A3E5E" CornerRadius="3.5" Margin="1"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#38BDF8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="MinWidth" Value="0"/>
                                <Setter Property="Height" Value="7"/>
                                <Setter Property="MinHeight" Value="7"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Deep-Sky CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Border x:Name="CheckBoxBd"
                                    Width="15" Height="15"
                                    CornerRadius="4"
                                    Background="#0A1120"
                                    BorderBrush="#2E4466"
                                    BorderThickness="1.2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0">
                                <Path x:Name="CheckMark"
                                      Data="M 3 7.5 L 6 10.5 L 11.5 4.2"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBd" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="CheckBoxBd" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBd" Property="BorderBrush" Value="#7DD3FC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default Sleek Dark Slider -->
        <Style TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Height="18">
                            <Border Height="4.5" CornerRadius="2.25" Background="#162238" Margin="6,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4.5" CornerRadius="2.25,0,0,2.25" Background="#0EA5E9" Margin="6,0,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4.5" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="16" Height="16">
                                                    <Ellipse x:Name="Halo" Width="16" Height="16" Fill="#38BDF8" Opacity="0.20"/>
                                                    <Ellipse Width="11" Height="11" Fill="#38BDF8" Stroke="#F8FAFC" StrokeThickness="1.6"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Halo" Property="Opacity" Value="0.45"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Telemetry Pill Style -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0A1120"/>
            <Setter Property="BorderBrush" Value="#1B2942"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- Animated Minimalist Observatory Button -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10192B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22324D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <Border x:Name="hoverGlow"
                                    Background="#1838BDF8"
                                    BorderBrush="#38BDF8"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.38"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Gradient Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Animated Observatory Toggle Button -->
        <Style x:Key="ModernToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#10192B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#22324D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <Border x:Name="hoverGlow"
                                    Background="#1538BDF8"
                                    BorderBrush="#4B6694"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetName="hoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#142E54"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Chip RadioButton Style -->
        <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Tag" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="10,4.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#16233B"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="chip" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>

        <!-- Floating Panel Glass Border Style (FillBehavior=Stop keeps TranslateTransform free for mouse dragging) -->
        <Style x:Key="FloatingPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#253858"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="15,13"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.78"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard Timeline.DesiredFrameRate="60">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="1.0"
                                                 Duration="0:0:0.20"
                                                 DecelerationRatio="0.35"
                                                 FillBehavior="Stop"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="10.0" To="0.0"
                                                 Duration="0:0:0.20"
                                                 DecelerationRatio="0.35"
                                                 FillBehavior="Stop"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Confidence Slider with Dynamic Color Binding -->
        <Style x:Key="ConfidenceSliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="22" Height="22">
                            <Ellipse Width="22" Height="22" Fill="{Binding ConfidenceBrush}" Opacity="0.28"/>
                            <Ellipse Width="14" Height="14" Fill="{Binding ConfidenceBrush}" Stroke="#FFFFFF" StrokeThickness="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfidenceSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" Background="#162238" Margin="7,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{Binding ConfidenceBrush}" Margin="7,0,0,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ConfidenceSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded ProgressBar Style -->
        <Style x:Key="ObservatoryProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#121C30"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0C1322"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="Padding" Value="10,6.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B3459"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#142C4A"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#10192B"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#22324D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="#10192B"
                                                BorderBrush="#22324D"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#94A3B8"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#18253F"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,24,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="#ECEFF4"/>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       Margin="10,3,24,3"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#0C1322"
                                            BorderBrush="#2A3E5E"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="0,3,0,0"
                                            Padding="3">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PlaceholderText" Property="Foreground" Value="#64748B"/>
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root Shell Container -->
    <Grid x:Name="RootContainer">
        <Grid x:Name="MainWorkspaceGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Observatory Header Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Unified Minimalist Control Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 2: Telemetry Pill Strip -->
                <RowDefinition Height="*"/>    <!-- Row 3: 2D / 3D Viewport + Welcome State + Floating Panels -->
                <RowDefinition Height="Auto"/> <!-- Row 4: Crisp Status Bar -->
            </Grid.RowDefinitions>

            <!-- ==================== ROW 0: OBSERVATORY GLASS HEADER ==================== -->
            <Border Grid.Row="0" Background="#080E1B" BorderBrush="#162136" BorderThickness="0,0,0,1" Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand, Glowing Emblem & Version -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0E1A30" BorderBrush="#1F3B61" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,10,0">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="AstroCounter" FontSize="15.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <Border Background="#112845" BorderBrush="#26548A" BorderThickness="1" CornerRadius="6" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding L_VersionBadge}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding L_HeaderSubtitle}" FontSize="9.5" Foreground="#64748B" Margin="0,1,0,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Segmented 2D Canvas | 3D Celestial Dome Switcher -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#050811" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="9" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding L_Mode2D}"
                                         GroupName="ViewModeSegmentGroup"
                                         IsChecked="{Binding Is2DViewActive, Mode=TwoWay}"
                                         Command="{Binding Select2DViewCommand}"
                                         Style="{StaticResource ChipRadioStyle}" Margin="1,0"/>
                            <RadioButton Content="{Binding L_Mode3D}"
                                         GroupName="ViewModeSegmentGroup"
                                         IsChecked="{Binding IsSphereModeActive, Mode=TwoWay}"
                                         Command="{Binding Select3DViewCommand}"
                                         Style="{StaticResource ChipRadioStyle}" Margin="1,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Primary Workspace Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton IsChecked="{Binding IsMosaicDrawerOpen, Mode=TwoWay}"
                                      Style="{StaticResource ModernToggleButtonStyle}"
                                      Margin="0,0,7,0"
                                      Padding="10,5.5"
                                      ToolTip="{Binding L_PhotosButtonToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧩" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_PhotosButtonText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <Button Content="{Binding L_SelectImage}"
                                Command="{Binding SelectImageCommand}"
                                ToolTip="{Binding L_SelectImageToolTip}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="13,5.5" Margin="0,0,7,0"/>

                        <Button Content="{Binding L_ExportButton}"
                                Command="{Binding ToggleExportPanelCommand}"
                                ToolTip="{Binding L_ExportButtonToolTip}"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="11,5.5" Margin="0,0,7,0"/>

                        <ToggleButton IsChecked="{Binding IsHelpPanelOpen, Mode=TwoWay}"
                                      Content="{Binding L_HelpButton}"
                                      ToolTip="{Binding L_HelpToolTip}"
                                      Style="{StaticResource ModernToggleButtonStyle}"
                                      FontWeight="SemiBold"
                                      FontSize="11.5"
                                      Padding="10,5.5"
                                      Margin="0,0,7,0"/>

                        <Button Content="{Binding LanguageButtonText}"
                                Command="{Binding ToggleLanguageCommand}"
                                ToolTip="{Binding L_LanguageToolTip}"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="10.5"
                                Padding="9,5.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== ROW 1: UNIFIED MINIMALIST TOOLBAR ==================== -->
            <Border Grid.Row="1" Background="#060B15" BorderBrush="#131D30" BorderThickness="0,0,0,1" Padding="18,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 1. Detection Engine Segment -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <TextBlock Text="{Binding L_EngineGroup}" Style="{StaticResource GroupLabelStyle}"/>
                        <Border Background="#0A1120" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="EngineMode" Content="{Binding L_HybridFusion}"
                                             IsChecked="{Binding IsHybridFusionMode}"
                                             Style="{StaticResource ChipRadioStyle}"/>
                                <RadioButton GroupName="EngineMode" Content="{Binding L_Photometry}"
                                             IsChecked="{Binding IsPhotometricMode}"
                                             Style="{StaticResource ChipRadioStyle}"/>
                                <RadioButton GroupName="EngineMode" Content="{Binding L_Yolo}"
                                             IsChecked="{Binding IsYoloMode}"
                                             Style="{StaticResource ChipRadioStyle}" Margin="0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0C172B" BorderBrush="#1D3D63" BorderThickness="1" CornerRadius="7" Padding="8,3.5" Margin="6,0,0,0" VerticalAlignment="Center"
                                ToolTip="{Binding L_AiModelBadgeToolTip}">
                            <TextBlock Text="{Binding L_AiModelBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                        </Border>
                        <Button Content="{Binding L_SelectModel}"
                                Command="{Binding SelectCustomModelCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="10.5" Padding="8,4" Margin="6,0,0,0"
                                Visibility="{Binding IsYoloMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Width="1" Height="20" Background="#18243A" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <!-- 2. Floating Inspector Popups (Light, Sensitivity, Layers) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                        <ToggleButton x:Name="LightPanelToggle"
                                      IsChecked="{Binding IsLightPanelOpen, Mode=TwoWay}"
                                      Style="{StaticResource ModernToggleButtonStyle}"
                                      ToolTip="{Binding L_LightPanelToolTip}"
                                      Margin="0,0,6,0"
                                      Padding="9,4.5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#9728;" Foreground="#FBBF24" FontSize="12.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_LightPanelButton}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="ConfidencePanelToggle"
                                      IsChecked="{Binding IsConfidencePanelOpen, Mode=TwoWay}"
                                      Style="{StaticResource ModernToggleButtonStyle}"
                                      ToolTip="{Binding L_ConfidencePanelToolTip}"
                                      Margin="0,0,6,0"
                                      Padding="9,4.5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConfidenceButtonText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding ConfidenceBrush}"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="LabelsPanelToggle"
                                      IsChecked="{Binding IsLabelsPanelOpen, Mode=TwoWay}"
                                      Style="{StaticResource ModernToggleButtonStyle}"
                                      ToolTip="{Binding L_LabelsPanelToolTip}"
                                      Padding="9,4.5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏷️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_LabelsPanelButton}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#38BDF8"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- 3. 2D ROI Scan Tools (Only shown in 2D view to keep 3D Dome extra clean) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2"
                                Visibility="{Binding Is2DViewActive, Converter={StaticResource BoolToVis}}">
                        <Border Width="1" Height="20" Background="#18243A" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding L_ScanAreaGroup}" Style="{StaticResource GroupLabelStyle}"/>
                        <Border Background="#0A1120" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="ScanTool" Content="{Binding L_Pan}"
                                             IsChecked="{Binding IsToolPan}"
                                             ToolTip="{Binding ToolHint}"
                                             Style="{StaticResource ChipRadioStyle}"/>
                                <RadioButton GroupName="ScanTool" Content="{Binding L_Rectangle}"
                                             IsChecked="{Binding IsToolRectangle}"
                                             ToolTip="{Binding ToolHint}"
                                             Style="{StaticResource ChipRadioStyle}"/>
                                <RadioButton GroupName="ScanTool" Content="{Binding L_Polygon}"
                                             IsChecked="{Binding IsToolPolygon}"
                                             ToolTip="{Binding ToolHint}"
                                             Style="{StaticResource ChipRadioStyle}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0A1120" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="RegionMode" Content="{Binding L_Exclude}"
                                             IsChecked="{Binding IsExcludeMode}"
                                             Tag="{StaticResource RedBrush}"
                                             Style="{StaticResource ChipRadioStyle}"/>
                                <RadioButton GroupName="RegionMode" Content="{Binding L_Include}"
                                             IsChecked="{Binding IsIncludeMode}"
                                             Tag="{StaticResource GreenBrush}"
                                             Style="{StaticResource ChipRadioStyle}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="↩" Command="{Binding UndoRegionCommand}"
                                ToolTip="{Binding L_Undo}"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="11" Padding="8,4" Margin="0,0,4,0"/>
                        <Button Content="✕" Command="{Binding ClearRegionsCommand}"
                                ToolTip="{Binding L_Clear}"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="11" Padding="8,4"/>
                    </StackPanel>

                    <!-- 4. Astrometry & Planetarium Controls -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                        <Button Command="{Binding PlateSolveCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                ToolTip="{Binding L_PlateSolveToolTip}"
                                Padding="10,4.5" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔭 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_PlateSolveButton}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ComboBox ItemsSource="{Binding AvailableTargetsInPhoto}"
                                  SelectedItem="{Binding SelectedCatalogueTarget, Mode=TwoWay}"
                                  IsEnabled="{Binding HasTargetsInPhoto}"
                                  Tag="{Binding TargetComboPlaceholderText}"
                                  DisplayMemberPath="CommonName"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  Width="215"
                                  Height="27"
                                  MaxDropDownHeight="320"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  ToolTip="{Binding L_TargetComboToolTip}"/>

                        <Button Command="{Binding ToggleStellariumCommand}"
                                Style="{StaticResource ModernButtonStyle}"
                                Padding="10,4.5" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#EF4444"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStellariumConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#10B981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StellariumStatusText}" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <CheckBox IsChecked="{Binding IsStellariumSyncEnabled, Mode=TwoWay}"
                                  Visibility="{Binding IsStellariumConnected, Converter={StaticResource BoolToVis}}"
                                  Content="{Binding L_TwoWaySync}"
                                  Foreground="#94A3B8"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="2,0,8,0"
                                  ToolTip="{Binding L_TwoWaySyncToolTip}"/>
                    </WrapPanel>
                </WrapPanel>
            </Border>

            <!-- ==================== ROW 2: TELEMETRY & DISCOVERY STRIP ==================== -->
            <Border Grid.Row="2" Background="#050810" BorderBrush="#111A2B" BorderThickness="0,0,0,1" Padding="18,5">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Total Objects Capsule -->
                        <Border Style="{StaticResource MetricCardStyle}" BorderBrush="#1C3454">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L_TotalObjects}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding TotalCount}" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tier 1: Bright (>10σ) -->
                        <Border Style="{StaticResource MetricCardStyle}" ToolTip="{Binding L_Tier1ToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding L_Tier1Label}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Tier1Count}" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tier 2: Medium (5-10σ) -->
                        <Border Style="{StaticResource MetricCardStyle}" ToolTip="{Binding L_Tier2ToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Fill="#FBBF24" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding L_Tier2Label}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Tier2Count}" FontSize="12.5" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tier 3: Faint (3-5σ) -->
                        <Border Style="{StaticResource MetricCardStyle}" ToolTip="{Binding L_Tier3ToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6.5" Height="6.5" Fill="#FB923C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding L_Tier3Label}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Tier3Count}" FontSize="12.5" FontWeight="Bold" Foreground="#FB923C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Candidate (<3σ) -->
                        <Border Style="{StaticResource MetricCardStyle}"
                                Visibility="{Binding HasSpeculativeObjects, Converter={StaticResource BoolToVis}}"
                                BorderBrush="#9F1239"
                                ToolTip="{Binding L_SpeculativeToolTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding L_Speculative}" FontSize="9.5" FontWeight="Bold" Foreground="#FDA4AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SpeculativeCount}" FontSize="12.5" FontWeight="Bold" Foreground="#FB7185" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Processing Time & Panels -->
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding ProcessingTimeText}" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TileCountText, StringFormat=' ({0})'}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Solved Target Coordinates Pill -->
                        <Border Background="#0B1E33" BorderBrush="#1D416B" BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding IsWcsAvailable, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding TargetDetailsText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🧭 " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SolvedCoordinatesText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Anomaly Hunter Alert Badge -->
                        <Border Background="#3B101A" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="9" Padding="10,4" Margin="0,0,6,0" VerticalAlignment="Center"
                                Visibility="{Binding HasAnomalies, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯 " FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_AnomaliesBadgeLabel}" Foreground="#FDA4AF" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding AnomalyCount}" Foreground="#FDA4AF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic Warning Badge -->
                        <Border Background="#2D1B04" BorderBrush="#D97706" BorderThickness="1" CornerRadius="9" Padding="10,4" VerticalAlignment="Center"
                                Visibility="{Binding HasDiagnosticWarning, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding DiagnosticWarningText}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ " FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DiagnosticWarningText}" Foreground="#FBBF24" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== ROW 3: MAIN INTERACTIVE VIEWPORT & FLOATING WINDOWS ==================== -->
            <ScrollViewer Grid.Row="3"
                          x:Name="ViewerScrollViewer"
                          Visibility="{Binding Is2DViewActive, Converter={StaticResource BoolToVis}}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"
                          Background="#04070E"
                          ScrollChanged="ViewerScrollViewer_ScrollChanged"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          PreviewMouseDown="ScrollViewer_PreviewMouseDown"
                          PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                          PreviewMouseUp="ScrollViewer_PreviewMouseUp">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:0.20" DecelerationRatio="0.3" FillBehavior="Stop"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <local:InfiniteCanvasPanel x:Name="CanvasContainer" RenderOptions.BitmapScalingMode="LowQuality"
                                           ClipToBounds="False"
                                           Width="{Binding CanvasWidth}"
                                           Height="{Binding CanvasHeight}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1.0" ScaleY="1.0"/>
                            <RotateTransform x:Name="CanvasRotate" Angle="{Binding ImageRotationAngle}"/>
                        </TransformGroup>
                    </Grid.LayoutTransform>

                    <local:InfiniteCanvasPanel x:Name="ImageSurface" ClipToBounds="False">
                        <Image x:Name="AstroImage"
                               Opacity="{Binding PhotoOpacity}"
                               Source="{Binding ImageBitmap}"
                               Width="{Binding ImageWidth}"
                               Height="{Binding ImageHeight}"
                               Visibility="{Binding IsSingleImageActive, Converter={StaticResource BoolToVis}}"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="LowQuality"/>

                        <local:DetectionOverlay x:Name="Overlay" RenderOptions.BitmapScalingMode="LowQuality"
                                                ClipToBounds="False"
                                                Width="{Binding CanvasWidth}"
                                                Height="{Binding CanvasHeight}"
                                                Objects="{Binding VisibleObjects}"
                                                Regions="{Binding RegionSnapshot}"
                                                ShowBoxes="{Binding ShowBoundingBoxes}"
                                                ShowLabels="{Binding ShowLabels}"
                                                ShowSphericalGrid="{Binding ShowSphericalGrid}"
                                                ShowHipparcosStars="{Binding ShowHipparcosStars}"
                                                ShowConstellations="{Binding ShowConstellations}"
                                                ShowDsoMarkers="{Binding ShowDsoMarkers}"
                                                MosaicPanels="{Binding MosaicPanels}"
                                                ActiveFilePath="{Binding SelectedImagePath}"
                                                UseFeatheredBlending="{Binding UseFeatheredBlending}"
                                                Wcs="{Binding CurrentWcs}"
                                                TargetMarkerPixel="{Binding TargetMarkerPixel}"
                                                TargetMarkerLabel="{Binding TargetMarkerLabel}"/>
                    </local:InfiniteCanvasPanel>
                </local:InfiniteCanvasPanel>
            </ScrollViewer>

            <!-- Crisp 1:1 DPI Empty State Welcome Card (Only in 2D view when empty) -->
            <Grid Grid.Row="3"
                  Visibility="{Binding Is2DViewActive, Converter={StaticResource BoolToVis}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Panel.ZIndex="40">
                <Border x:Name="PlaceholderBorder"
                        Width="780"
                        BorderBrush="#223656" BorderThickness="1.2"
                        CornerRadius="20"
                        Padding="36,30"
                        Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.22" Center="0.5,0.25" RadiusX="0.85" RadiusY="0.9">
                            <GradientStop Color="#EE111D36" Offset="0.0"/>
                            <GradientStop Color="#F6080E1B" Offset="0.65"/>
                            <GradientStop Color="#FA060A14" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="10" Opacity="0.78"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard Timeline.DesiredFrameRate="60">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.35" DecelerationRatio="0.35" FillBehavior="Stop"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Cosmic Breathing Halo Emblem -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Ellipse Width="108" Height="108">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#4438BDF8" Offset="0.0"/>
                                        <GradientStop Color="#14A855F7" Offset="0.55"/>
                                        <GradientStop Color="#00000000" Offset="1.0"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True" Timeline.DesiredFrameRate="30">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0.95" Duration="0:0:2.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Border Background="#0B1528" BorderBrush="#2A4B75" BorderThickness="1.2" CornerRadius="36" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/logo.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding L_PlaceholderTitle}" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{Binding L_PlaceholderFormats}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,22"/>

                        <!-- Beginner 3-Step Workflow Mini-Cards -->
                        <UniformGrid Columns="3" Width="680" Margin="0,0,0,22">
                            <Border Background="#0C1628" BorderBrush="#1D3354" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="📷" FontSize="16" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding L_OnboardStep1Title}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding L_OnboardStep1Desc}" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0C1628" BorderBrush="#1D3D4A" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="✨" FontSize="16" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding L_OnboardStep2Title}" Foreground="#34D399" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding L_OnboardStep2Desc}" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0C1628" BorderBrush="#2D2754" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🌌" FontSize="16" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding L_OnboardStep3Title}" Foreground="#C084FC" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding L_OnboardStep3Desc}" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" LineHeight="15"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Button Content="{Binding L_PlaceholderBrowse}"
                                Command="{Binding SelectImageCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                FontSize="12.5" FontWeight="Bold"
                                Padding="24,10"/>

                        <TextBlock Text="{Binding L_PlaceholderDropHint}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3D NAVIGABLE CELESTIAL SPHERE PLANETARIUM -->
            <local:CelestialSphereControl x:Name="SphereControl"
                                          Grid.Row="3"
                                          CurrentWcs="{Binding CurrentWcs}"
                                          MosaicPanels="{Binding MosaicPanels}"
                                          ActiveFilePath="{Binding SelectedImagePath}"
                                          ActiveImageBitmap="{Binding ImageBitmap}"
                                          VisibleObjects="{Binding VisibleObjects}"
                                          ShowBoundingBoxes="{Binding ShowBoundingBoxes}"
                                          ShowLabels="{Binding ShowLabels}"
                                          ShowHipparcosStars="{Binding ShowHipparcosStars}"
                                          ShowConstellations="{Binding ShowConstellations}"
                                          ShowDsoMarkers="{Binding ShowDsoMarkers}"
                                          ShowSphericalGrid="{Binding ShowSphericalGrid}"
                                          PhotoOpacity="{Binding PhotoOpacity}"
                                          Regions="{Binding RegionSnapshot}"
                                          TotalCount="{Binding TotalCount}"
                                          Tier1Count="{Binding Tier1Count}"
                                          Tier2Count="{Binding Tier2Count}"
                                          Tier3Count="{Binding Tier3Count}"
                                          UseFeatheredBlending="{Binding UseFeatheredBlending}"
                                          ExitCommand="{Binding ToggleSphereModeCommand}"
                                          Visibility="{Binding IsSphereModeActive, Converter={StaticResource BoolToVis}}">
                <local:CelestialSphereControl.Style>
                    <Style TargetType="local:CelestialSphereControl">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard Timeline.DesiredFrameRate="60">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.25" To="1.0" Duration="0:0:0.22" DecelerationRatio="0.3" FillBehavior="Stop"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </local:CelestialSphereControl.Style>
            </local:CelestialSphereControl>

            <!-- ==================== DRAGGABLE FLOATING WINDOW 1: LAYERS & LABELS ==================== -->
            <Border x:Name="LabelsPanelBorder"
                    Grid.Row="3"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="18,14,0,0"
                    Width="312"
                    Panel.ZIndex="106"
                    Style="{StaticResource FloatingPanelStyle}"
                    PreviewMouseDown="FloatingPanel_PreviewMouseDown"
                    Visibility="{Binding IsLabelsPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border Background="Transparent"
                            Cursor="SizeAll"
                            Margin="0,0,0,10"
                            ToolTip="{Binding L_PanelDragHint}"
                            MouseLeftButtonDown="FloatingPanelHeader_MouseLeftButtonDown"
                            MouseMove="FloatingPanelHeader_MouseMove"
                            MouseLeftButtonUp="FloatingPanelHeader_MouseLeftButtonUp">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding CloseLabelsPanelCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="4,0" FontSize="11" Width="24" Height="24"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="🏷️" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_LabelsPanelTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding L_CheckAll}" Command="{Binding CheckAllOverlaysCommand}"
                                Style="{StaticResource ModernButtonStyle}" FontSize="10.5" Padding="4,4.5" Margin="0,0,4,0"/>
                        <Button Grid.Column="1" Content="{Binding L_UncheckAll}" Command="{Binding UncheckAllOverlaysCommand}"
                                Style="{StaticResource ModernButtonStyle}" FontSize="10.5" Padding="4,4.5" Margin="4,0,0,0"/>
                    </Grid>

                    <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding L_DetectionsCategory}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,0,0,7"/>
                            <CheckBox IsChecked="{Binding ShowBoundingBoxes, Mode=TwoWay}"
                                      Content="{Binding L_Boxes}"
                                      Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox IsChecked="{Binding ShowLabels, Mode=TwoWay}"
                                      Content="{Binding L_Labels}"
                                      Foreground="#E2E8F0" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="11,9">
                        <StackPanel>
                            <TextBlock Text="{Binding L_AtlasCategory}" Foreground="#C084FC" FontWeight="Bold" FontSize="11" Margin="0,0,0,7"/>
                            <CheckBox IsChecked="{Binding ShowHipparcosStars, Mode=TwoWay}"
                                      Content="{Binding L_HipparcosStars}"
                                      ToolTip="{Binding L_HipparcosStarsToolTip}"
                                      Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox IsChecked="{Binding ShowConstellations, Mode=TwoWay}"
                                      Content="{Binding L_Constellations}"
                                      ToolTip="{Binding L_ConstellationsToolTip}"
                                      Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox IsChecked="{Binding ShowDsoMarkers, Mode=TwoWay}"
                                      Content="{Binding L_DsoMarkers}"
                                      ToolTip="{Binding L_DsoMarkersToolTip}"
                                      Foreground="#E2E8F0" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox IsChecked="{Binding ShowSphericalGrid, Mode=TwoWay}"
                                      Content="{Binding L_SphericalGrid}"
                                      ToolTip="{Binding L_SphericalGridToolTip}"
                                      Foreground="#E2E8F0" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== DRAGGABLE FLOATING WINDOW 2: CONFIDENCE & SENSITIVITY ==================== -->
            <Border x:Name="ConfidencePanelBorder"
                    Grid.Row="3"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="48,34,0,0"
                    Width="356"
                    Panel.ZIndex="105"
                    Style="{StaticResource FloatingPanelStyle}"
                    PreviewMouseDown="FloatingPanel_PreviewMouseDown"
                    Visibility="{Binding IsConfidencePanelOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border Background="Transparent"
                            Cursor="SizeAll"
                            Margin="0,0,0,10"
                            ToolTip="{Binding L_PanelDragHint}"
                            MouseLeftButtonDown="FloatingPanelHeader_MouseLeftButtonDown"
                            MouseMove="FloatingPanelHeader_MouseMove"
                            MouseLeftButtonUp="FloatingPanelHeader_MouseLeftButtonUp">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding CloseConfidencePanelCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="4,0" FontSize="11" Width="24" Height="24"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#F59E0B"/>
                                <TextBlock Text="{Binding L_ConfidencePanelTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#0B1528" BorderBrush="#1C3960" BorderThickness="1" CornerRadius="8" Padding="9,5.5" Margin="0,0,0,8"
                            Visibility="{Binding HasLoadedImage, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding L_ActivePhotoLabel}" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ActivePanelDisplayName}" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IsAutoConfidenceEnabled, Mode=TwoWay}"
                                      Content="{Binding L_AutoConfidenceToggle}"
                                      Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="{Binding L_AutoConfidenceDesc}" Foreground="#94A3B8" FontSize="10" Margin="22,5,0,7" TextWrapping="Wrap" LineHeight="14"/>
                            <Button Content="{Binding L_RecalculateAuto}"
                                    Command="{Binding ApplyAutoConfidenceCommand}"
                                    ToolTip="{Binding L_AutoConfidenceToolTip}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    HorizontalAlignment="Left" Margin="22,0,0,0"
                                    FontSize="10.5" Padding="9,4"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                        <TextBlock Text="{Binding L_ConfidenceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfidencePercentText}" FontSize="12" FontWeight="Bold" Foreground="{Binding ConfidenceBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfidenceStatusText}" Foreground="{Binding ConfidenceBrush}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Slider Style="{StaticResource ConfidenceSliderStyle}"
                            Minimum="0.02" Maximum="0.99"
                            Value="{Binding ConfidenceThreshold, Mode=TwoWay}"
                            SmallChange="0.01" LargeChange="0.05"
                            TickFrequency="0.05" IsSnapToTickEnabled="False"
                            Margin="0,4,0,10"/>

                    <TextBlock Text="{Binding L_QuickPresets}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                    <UniformGrid Columns="4" Margin="0,0,0,9">
                        <Button Content="18%" Command="{Binding PresetConfidenceCommand}" CommandParameter="0.18" Style="{StaticResource ModernButtonStyle}" FontSize="10.5" Padding="4,4.5" Margin="0,0,3,0"/>
                        <Button Content="25%" Command="{Binding PresetConfidenceCommand}" CommandParameter="0.25" Style="{StaticResource ModernButtonStyle}" FontSize="10.5" Padding="4,4.5" Margin="2,0"/>
                        <Button Content="50%" Command="{Binding PresetConfidenceCommand}" CommandParameter="0.50" Style="{StaticResource ModernButtonStyle}" FontSize="10.5" Padding="4,4.5" Margin="2,0"/>
                        <Button Content="80%" Command="{Binding PresetConfidenceCommand}" CommandParameter="0.80" Style="{StaticResource ModernButtonStyle}" FontSize="10.5" Padding="4,4.5" Margin="3,0,0,0"/>
                    </UniformGrid>

                    <Border Background="#0A1120" BorderBrush="#1B2942" BorderThickness="1" CornerRadius="10" Padding="9,7"
                            Visibility="{Binding HasPanels, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding L_PerPhotoConfidenceHeader}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                            <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MosaicPanels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ConfidencePercentText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="10" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <Border Background="{Binding FormatBadgeBackground}" BorderBrush="{Binding FormatBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="4,0.5" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="{Binding FormatBadgeTooltip}">
                                                                <TextBlock Text="{Binding FormatBadgeText}" Foreground="{Binding FormatBadgeForeground}" FontSize="8" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Slider Grid.Row="1" Minimum="0.02" Maximum="0.99" Value="{Binding ConfidenceThreshold, Mode=TwoWay}" SmallChange="0.01" LargeChange="0.05"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== DRAGGABLE FLOATING WINDOW 3: DISPLAY, LIGHT & OPACITY ==================== -->
            <Border x:Name="LightPanelBorder"
                    Grid.Row="3"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="18,14,0,0"
                    Width="332"
                    Panel.ZIndex="104"
                    Style="{StaticResource FloatingPanelStyle}"
                    PreviewMouseDown="FloatingPanel_PreviewMouseDown"
                    Visibility="{Binding IsLightPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border Background="Transparent"
                            Cursor="SizeAll"
                            Margin="0,0,0,10"
                            ToolTip="{Binding L_PanelDragHint}"
                            MouseLeftButtonDown="FloatingPanelHeader_MouseLeftButtonDown"
                            MouseMove="FloatingPanelHeader_MouseMove"
                            MouseLeftButtonUp="FloatingPanelHeader_MouseLeftButtonUp">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding CloseLightPanelCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="4,0" FontSize="11" Width="24" Height="24"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="&#9728;" Foreground="#FBBF24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_LightPanelTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Background="#0B1528" BorderBrush="#1C3960" BorderThickness="1" CornerRadius="8" Padding="9,5.5" Margin="0,0,0,8"
                            Visibility="{Binding HasLoadedImage, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="{Binding L_ActivePhotoLabel}" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ActivePanelDisplayName}" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding IsAutoBrightnessEnabled, Mode=TwoWay}"
                                      Content="{Binding L_AutoBalanceLabel}"
                                      Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="{Binding BrightnessStatusText}" Foreground="#94A3B8" FontSize="10" Margin="22,5,0,7" TextTrimming="CharacterEllipsis"/>
                            <Button Content="{Binding L_AutoBalanceNow}"
                                    Command="{Binding AutoBalanceNowCommand}"
                                    ToolTip="{Binding L_AutoBrightnessToolTip}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    HorizontalAlignment="Left" Margin="22,0,0,0"
                                    FontSize="10.5" Padding="9,4"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,2,0,5" ToolTip="{Binding L_PhotoOpacityToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding L_PhotoOpacityLabel}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0.05" Maximum="1.0" Value="{Binding PhotoOpacity, Mode=TwoWay}" VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.2"/>
                        <TextBlock Grid.Column="2" Text="{Binding PhotoOpacityPercentText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding L_BrightnessLabel}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding DisplayBrightness, Mode=TwoWay}" VerticalAlignment="Center" SmallChange="1" LargeChange="10"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayBrightnessText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding L_ExposureLabel}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0.2" Maximum="3.0" Value="{Binding DisplayExposure, Mode=TwoWay}" VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.2"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayExposureText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding L_ContrastLabel}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="2.5" Value="{Binding DisplayContrast, Mode=TwoWay}" VerticalAlignment="Center" SmallChange="0.05" LargeChange="0.2"/>
                        <TextBlock Grid.Column="2" Text="{Binding DisplayContrastText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="{Binding L_ResetAdjustments}"
                            Command="{Binding ResetDisplayAdjustmentsCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            HorizontalAlignment="Right"
                            FontSize="10.5" Padding="11,4.5"/>
                </StackPanel>
            </Border>

            <!-- ==================== DRAGGABLE FLOATING WINDOW 4: PHOTOS & MOSAIC MANAGER ==================== -->
            <Border x:Name="MosaicDrawerBorder"
                    Grid.Row="3"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,58,18,0"
                    Width="366" MaxHeight="550"
                    Panel.ZIndex="108"
                    Style="{StaticResource FloatingPanelStyle}"
                    PreviewMouseDown="FloatingPanel_PreviewMouseDown"
                    Visibility="{Binding IsMosaicDrawerOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Margin="0,0,0,10"
                            ToolTip="{Binding L_PanelDragHint}"
                            MouseLeftButtonDown="FloatingPanelHeader_MouseLeftButtonDown"
                            MouseMove="FloatingPanelHeader_MouseMove"
                            MouseLeftButtonUp="FloatingPanelHeader_MouseLeftButtonUp">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding CloseMosaicDrawerCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="4,0" FontSize="11" Width="24" Height="24"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="🧩" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_MosaicDrawerTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{Binding L_AddPhotosButton}"
                                    Command="{Binding AddPhotosCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="6,5.5" FontSize="10.5" Margin="0,0,4,0"
                                    ToolTip="{Binding L_AddPhotosToolTip}"/>
                            <Button Grid.Column="1" Content="{Binding L_AlignAllButton}"
                                    Command="{Binding PlateSolveAllPanelsCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="6,5.5" FontSize="10.5" Margin="2,0,4,0"
                                    ToolTip="{Binding L_AlignAllToolTip}"/>
                            <Button Grid.Column="2" Content="{Binding L_ClearAllButton}"
                                    Command="{Binding ClearAllPanelsCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="9,5.5" FontSize="10.5"
                                    ToolTip="{Binding L_ClearAllToolTip}"/>
                        </Grid>

                        <CheckBox Content="{Binding L_FeatheredBlending}"
                                  IsChecked="{Binding UseFeatheredBlending, Mode=TwoWay}"
                                  Margin="2,0,0,6" Foreground="#CBD5E1" FontSize="11"
                                  ToolTip="{Binding L_FeatheredBlending}"/>

                        <DockPanel LastChildFill="True" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="{Binding L_SelectAllPhotosButton}" Command="{Binding SelectAllPanelsCommand}" Style="{StaticResource ModernButtonStyle}" FontSize="9.5" Padding="6,2.5" Margin="0,0,4,0"/>
                                <Button Content="{Binding L_ClearSelectionButton}" Command="{Binding ClearPanelSelectionCommand}" Style="{StaticResource ModernButtonStyle}" FontSize="9.5" Padding="6,2.5"/>
                            </StackPanel>
                            <TextBlock Text="{Binding L_DragReorderHint}" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>

                        <Border Background="#0B162C" BorderBrush="#1C3A60" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,2"
                                Visibility="{Binding HasMosaicCountResult, Converter={StaticResource BoolToVis}}">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MosaicOverlapStarsCount, StringFormat='{}↔ {0:N0}'}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MosaicUniqueStarsCount, StringFormat='{}🌌 {0:N0}'}" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer x:Name="MosaicCardsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="390">
                        <StackPanel>
                            <TextBlock Text="{Binding L_EmptyMosaic}"
                                       Foreground="#64748B" FontSize="11" FontStyle="Italic" Margin="8,18"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding IsMosaicEmpty, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl x:Name="MosaicCardsItemsControl" ItemsSource="{Binding MosaicPanels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CardBackground}"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                BorderThickness="{Binding CardBorderThickness}"
                                                CornerRadius="10" Padding="10,8" Margin="0,0,0,7"
                                                AllowDrop="True"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                PreviewMouseLeftButtonDown="PhotoCard_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="PhotoCard_PreviewMouseMove"
                                                DragOver="PhotoCard_DragOver"
                                                Drop="PhotoCard_Drop">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0" LastChildFill="True">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="▲"
                                                                Command="{Binding DataContext.MoveMosaicPanelUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ModernButtonStyle}"
                                                                Padding="5,1" FontSize="9" Margin="0,0,2,0" ToolTip="{Binding DataContext.L_MoveUp, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Button Content="▼"
                                                                Command="{Binding DataContext.MoveMosaicPanelDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ModernButtonStyle}"
                                                                Padding="5,1" FontSize="9" Margin="0,0,4,0" ToolTip="{Binding DataContext.L_MoveDown, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        <Button Content="✕"
                                                                Command="{Binding DataContext.RemoveMosaicPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ModernButtonStyle}"
                                                                Padding="5,1" FontSize="10"
                                                                ToolTip="{Binding DataContext.L_RemovePanel, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <Button Style="{StaticResource ModernButtonStyle}"
                                                            Command="{Binding DataContext.SelectMosaicPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderBrush="Transparent"
                                                            Padding="2,0" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="⋮⋮ " Foreground="#64748B" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" MaxWidth="132" TextTrimming="CharacterEllipsis"/>
                                                            <Border Background="{Binding FormatBadgeBackground}" BorderBrush="{Binding FormatBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{Binding FormatBadgeTooltip}">
                                                                <TextBlock Text="{Binding FormatBadgeText}" Foreground="{Binding FormatBadgeForeground}" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Button>
                                                </DockPanel>

                                                <StackPanel Grid.Row="1" Margin="22,4,0,5">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="#34D399" FontSize="9.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding CenterCoordinatesText}" Foreground="#94A3B8" FontSize="10"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ResolutionText}" Foreground="#64748B" FontSize="9"/>
                                                </StackPanel>

                                                <Grid Grid.Row="2" Margin="22,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="34"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding L_OpacityLabel}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Slider Grid.Column="1" Minimum="0.05" Maximum="1.0" Value="{Binding Opacity, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.2" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat='{}{0:P0}'}" Foreground="#CBD5E1" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==================== DRAGGABLE FLOATING WINDOW 5: ADVANCED EXPORT ==================== -->
            <Border x:Name="ExportPanelBorder"
                    Grid.Row="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="500" MaxHeight="660"
                    Panel.ZIndex="120"
                    Style="{StaticResource FloatingPanelStyle}"
                    BorderBrush="#38BDF8"
                    PreviewMouseDown="FloatingPanel_PreviewMouseDown"
                    Visibility="{Binding IsExportPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Draggable Header -->
                    <Border Grid.Row="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Margin="0,0,0,10"
                            ToolTip="{Binding L_PanelDragHint}"
                            MouseLeftButtonDown="FloatingPanelHeader_MouseLeftButtonDown"
                            MouseMove="FloatingPanelHeader_MouseMove"
                            MouseLeftButtonUp="FloatingPanelHeader_MouseLeftButtonUp">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding CloseExportPanelCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="4,0" FontSize="11" Width="24" Height="24"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="🚀" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_ExportPanelTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable Options Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="490" Padding="0,0,4,0">
                        <StackPanel>
                            <!-- Card 1: Projection Mode + Live Mosaic Area -->
                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_ExportProjectionLabel}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton Content="{Binding L_ExportProj2D}" IsChecked="{Binding IsExportCanvas2D, Mode=TwoWay}" GroupName="ProjGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,6,4"/>
                                        <RadioButton Content="{Binding L_ExportProj360}" IsChecked="{Binding IsExportPanorama360, Mode=TwoWay}" GroupName="ProjGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <Border Background="#091122" BorderBrush="#1B3356" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding ExportMosaicNativeAreaText}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Format + Optional JPG Quality -->
                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_ExportFormatLabel}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton Content="PNG" IsChecked="{Binding IsFormatPng, Mode=TwoWay}" GroupName="FmtGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,6,4"/>
                                        <RadioButton Content="{Binding L_FormatTiffLossless}" IsChecked="{Binding IsFormatTiff, Mode=TwoWay}" GroupName="FmtGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,6,4"/>
                                        <RadioButton Content="JPG" IsChecked="{Binding IsFormatJpg, Mode=TwoWay}" GroupName="FmtGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,6,4"/>
                                        <RadioButton Content="CSV" IsChecked="{Binding IsFormatCsv, Mode=TwoWay}" GroupName="FmtGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,6,4"/>
                                        <RadioButton Content="JSON" IsChecked="{Binding IsFormatJson, Mode=TwoWay}" GroupName="FmtGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,6,4"/>
                                    </WrapPanel>
                                    <Grid Margin="0,6,0,0" Visibility="{Binding IsFormatJpg, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding L_ExportJpgQuality}" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1" Minimum="50" Maximum="100" Value="{Binding ExportJpegQuality, Mode=TwoWay}" VerticalAlignment="Center" SmallChange="1" LargeChange="5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ExportJpegQualityText}" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Resolution Presets + Custom Width/Height + Live Target Output -->
                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,9"
                                    Visibility="{Binding IsImageExportFormat, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,7">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding L_ExportScaleLabel}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExportTargetResolutionText}" Foreground="#34D399" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton Content="{Binding L_ResNative}" IsChecked="{Binding IsResNative, Mode=TwoWay}" GroupName="ResGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,5,5"/>
                                        <RadioButton Content="{Binding L_Res1x}" IsChecked="{Binding IsRes1x, Mode=TwoWay}" GroupName="ResGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,5,5"/>
                                        <RadioButton Content="{Binding L_Res2x}" IsChecked="{Binding IsRes2x, Mode=TwoWay}" GroupName="ResGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,5,5"/>
                                        <RadioButton Content="{Binding L_Res4K}" IsChecked="{Binding IsRes4K, Mode=TwoWay}" GroupName="ResGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,5,5"/>
                                        <RadioButton Content="{Binding L_Res8K}" IsChecked="{Binding IsRes8K, Mode=TwoWay}" GroupName="ResGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,5,5"/>
                                        <RadioButton Content="{Binding L_ResCustom}" IsChecked="{Binding IsResCustom, Mode=TwoWay}" GroupName="ResGroup" Style="{StaticResource ChipRadioStyle}" Margin="0,0,0,5"/>
                                    </WrapPanel>

                                    <Border Background="#091122" BorderBrush="#1C2E4F" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0"
                                            Visibility="{Binding IsResCustom, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="74"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding L_ExportCustomWidth}" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding ExportCustomWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#060C18" Foreground="#F8FAFC" BorderBrush="#263B5E" BorderThickness="1" Padding="6,3" FontSize="11" CaretBrush="#38BDF8" VerticalContentAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="×" Foreground="#64748B" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="7,0,7,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding L_ExportCustomHeight}" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="4" Text="{Binding ExportCustomHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="#060C18" Foreground="#F8FAFC" BorderBrush="#263B5E" BorderThickness="1" Padding="6,3" FontSize="11" CaretBrush="#38BDF8" VerticalContentAlignment="Center"/>
                                            <CheckBox Grid.Column="5" Content="{Binding L_ExportLockAspect}" IsChecked="{Binding ExportLockAspectRatio, Mode=TwoWay}" Foreground="#CBD5E1" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Overlay Layers & Seamless Sky Blending -->
                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,9"
                                    Visibility="{Binding IsImageExportFormat, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_ExportLayersLabel}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,7"/>
                                    <UniformGrid Columns="2">
                                        <CheckBox Content="{Binding L_ExportBoxes}" IsChecked="{Binding ExportIncludeBoxes, Mode=TwoWay}" Foreground="#F1F5F9" FontSize="11" Margin="0,0,0,6"/>
                                        <CheckBox Content="{Binding L_ExportLabels}" IsChecked="{Binding ExportIncludeLabels, Mode=TwoWay}" Foreground="#F1F5F9" FontSize="11" Margin="0,0,0,6"/>
                                        <CheckBox Content="{Binding L_ExportGrid}" IsChecked="{Binding ExportIncludeGrid, Mode=TwoWay}" Foreground="#F1F5F9" FontSize="11" Margin="0,0,0,6"/>
                                        <CheckBox Content="{Binding L_ExportConstellations}" IsChecked="{Binding ExportIncludeConstellations, Mode=TwoWay}" Foreground="#F1F5F9" FontSize="11" Margin="0,0,0,6"/>
                                        <CheckBox Content="{Binding L_ExportDso}" IsChecked="{Binding ExportIncludeDsoMarkers, Mode=TwoWay}" Foreground="#F1F5F9" FontSize="11" Margin="0,0,0,2"/>
                                        <CheckBox Content="{Binding L_ExportHarmonize}" IsChecked="{Binding ExportHarmonizeMosaic, Mode=TwoWay}" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,2"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Always-On Smart Empty-Corner Watermark Info -->
                            <Border Background="#0A192E" BorderBrush="#1D436F" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,0,4"
                                    Visibility="{Binding IsImageExportFormat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ExportWatermarkNoticeText}" Foreground="#BAE6FD" FontSize="10.5" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="{Binding L_Cancel}" Command="{Binding CloseExportPanelCommand}" Style="{StaticResource ModernButtonStyle}" Padding="13,6" Margin="0,0,8,0" FontSize="11"/>
                        <Button Content="{Binding L_PerformExport}" Command="{Binding PerformExportCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,6.5" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== DRAGGABLE FLOATING WINDOW 6: BEGINNER GUIDE & SHORTCUTS ==================== -->
            <Border x:Name="HelpPanelBorder"
                    Grid.Row="3"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,22,0"
                    Width="448" MaxHeight="590"
                    Panel.ZIndex="125"
                    Style="{StaticResource FloatingPanelStyle}"
                    BorderBrush="#38BDF8"
                    PreviewMouseDown="FloatingPanel_PreviewMouseDown"
                    Visibility="{Binding IsHelpPanelOpen, Converter={StaticResource BoolToVis}}">
                <Border.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Margin="0,0,0,10"
                            ToolTip="{Binding L_PanelDragHint}"
                            MouseLeftButtonDown="FloatingPanelHeader_MouseLeftButtonDown"
                            MouseMove="FloatingPanelHeader_MouseMove"
                            MouseLeftButtonUp="FloatingPanelHeader_MouseLeftButtonUp">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="✕"
                                    Command="{Binding CloseHelpPanelCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="4,0" FontSize="11" Width="24" Height="24"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⋮⋮" Foreground="#64748B" FontWeight="Bold" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="❓" FontSize="13.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding L_HelpPanelTitle}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="515">
                        <StackPanel>
                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_HelpSec1Title}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding L_HelpSec1Body}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_HelpSec2Title}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding L_HelpSec2Body}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_HelpSec3Title}" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding L_HelpSec3Body}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_HelpSec4Title}" Foreground="#34D399" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding L_HelpSec4Body}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_HelpSec5Title}" Foreground="#C084FC" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding L_HelpSec5Body}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#0E1729" BorderBrush="#1C2C47" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding L_HelpSec6Title}" Foreground="#F472B6" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding L_HelpSec6Body}" Foreground="#CBD5E1" FontSize="10.5" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ==================== ROW 4: CRISP STATUS BAR ==================== -->
            <Border Grid.Row="4" Background="#060A13" BorderBrush="#131D30" BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="156"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Border Grid.Column="1" Background="#0A1426" BorderBrush="#1A2B45" BorderThickness="1" CornerRadius="7" Padding="8,2.5" Margin="10,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HardwareInfo}" Foreground="#34D399" FontWeight="SemiBold" FontSize="10"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L_CursorLabel}" Foreground="#64748B" FontSize="11"/>
                        <TextBlock Text="{Binding CursorCelestialText}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L_ZoomLabel}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ZoomPercentText" Text="100%" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Width="38"/>
                        <Button Content="{Binding L_FitButton}" Click="FitZoom_Click" ToolTip="{Binding L_ZoomFitToolTip}" Style="{StaticResource ModernButtonStyle}" Padding="8,2.5" Margin="4,0,0,0" FontSize="10"/>
                        <Button Content="100%" Click="ResetZoom_Click" ToolTip="{Binding L_Zoom100ToolTip}" Style="{StaticResource ModernButtonStyle}" Padding="8,2.5" Margin="4,0,0,0" FontSize="10"/>
                    </StackPanel>

                    <ProgressBar Grid.Column="4"
                                 Style="{StaticResource ObservatoryProgressStyle}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ASYNC EXPORT LOADING OVERLAY ==================== -->
        <Grid x:Name="ExportLoadingOverlay"
              Panel.ZIndex="950"
              Background="#D9040812"
              Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="60">
                            <DoubleAnimation Storyboard.TargetName="ExportRingRotate"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360"
                                             Duration="0:0:2.8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Border Background="#F20B1325"
                    BorderBrush="#38BDF8"
                    BorderThickness="1.5"
                    CornerRadius="20"
                    Padding="34,28"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="0" Opacity="0.82"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Animated Orbital Spinner & Emblem -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Ellipse Width="102" Height="102" RenderTransformOrigin="0.5,0.5"
                                 StrokeThickness="2" StrokeDashArray="9 5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="ExportRingRotate" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF38BDF8" Offset="0.0"/>
                                    <GradientStop Color="#66A855F7" Offset="0.55"/>
                                    <GradientStop Color="#1138BDF8" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>
                        <Border Background="#0D1930" BorderBrush="#264C7D" BorderThickness="1.2" CornerRadius="34" Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding L_ExportOverlayTitle}" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding L_ExportOverlaySubtitle}" FontSize="11.5" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,14"/>

                    <!-- Live Target Detail Pill -->
                    <Border Background="#0A1A32" BorderBrush="#1C3960" BorderThickness="1" CornerRadius="8" Padding="10,4.5" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="{Binding ExportProgressDetail}" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Live Progress Bar & Percent -->
                    <DockPanel Width="350" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ExportProgressStage}" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis" MaxWidth="295"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExportProgressPercentText}" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ObservatoryProgressStyle}"
                                 Width="350" Height="8"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ExportProgressValue, Mode=OneWay}"
                                 Margin="0,0,0,18"/>

                    <Button Content="{Binding L_ExportCancelButton}"
                            Command="{Binding CancelExportCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="18,6.5"
                            FontSize="11.5"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== NON-BLOCKING 1.2s STARTUP INTRO OVERLAY ==================== -->
        <Grid x:Name="SplashOverlay"
              Panel.ZIndex="999"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
            </Grid.RenderTransform>
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="#FF0A1328" Offset="0.0"/>
                    <GradientStop Color="#FF060A16" Offset="0.55"/>
                    <GradientStop Color="#FF03060C" Offset="1.0"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard Timeline.DesiredFrameRate="60">
                            <!-- Smooth intro scale out and fade reveal -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1.0" To="0.0"
                                             BeginTime="0:0:0.90" Duration="0:0:0.35"
                                             DecelerationRatio="0.4"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1.0" To="1.045"
                                             BeginTime="0:0:0.90" Duration="0:0:0.35"
                                             DecelerationRatio="0.4"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1.0" To="1.045"
                                             BeginTime="0:0:0.90" Duration="0:0:0.35"
                                             DecelerationRatio="0.4"/>
                            <!-- Subtle orbital ring rotation & emblem pop -->
                            <DoubleAnimation Storyboard.TargetName="SplashRingRotate" Storyboard.TargetProperty="Angle"
                                             From="-35" To="25" Duration="0:0:1.15" DecelerationRatio="0.5"/>
                            <DoubleAnimation Storyboard.TargetName="SplashEmblemScale" Storyboard.TargetProperty="ScaleX"
                                             From="0.82" To="1.0" Duration="0:0:0.45" DecelerationRatio="0.6"/>
                            <DoubleAnimation Storyboard.TargetName="SplashEmblemScale" Storyboard.TargetProperty="ScaleY"
                                             From="0.82" To="1.0" Duration="0:0:0.45" DecelerationRatio="0.6"/>
                            <DoubleAnimation Storyboard.TargetName="SplashTextSlide" Storyboard.TargetProperty="Y"
                                             From="16" To="0" Duration="0:0:0.45" DecelerationRatio="0.6"/>
                            <DoubleAnimation Storyboard.TargetName="SplashTextGroup" Storyboard.TargetProperty="Opacity"
                                             From="0.0" To="1.0" Duration="0:0:0.38" DecelerationRatio="0.4"/>
                            <DoubleAnimation Storyboard.TargetName="SplashProgressFill" Storyboard.TargetProperty="Width"
                                             From="0" To="176" BeginTime="0:0:0.12" Duration="0:0:0.75" AccelerationRatio="0.2" DecelerationRatio="0.4"/>
                            <!-- Automatically collapse overlay once finished -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:1.26">
                                    <DiscreteObjectKeyFrame.Value>
                                        <Visibility>Collapsed</Visibility>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid HorizontalAlignment="Center" Margin="0,0,0,18" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SplashEmblemScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Ellipse Width="144" Height="144" RenderTransformOrigin="0.5,0.5"
                             StrokeThickness="1.5" StrokeDashArray="8 6">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SplashRingRotate" Angle="0"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC38BDF8" Offset="0.0"/>
                                <GradientStop Color="#44A855F7" Offset="0.5"/>
                                <GradientStop Color="#0038BDF8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <Ellipse Width="120" Height="120">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#3838BDF8" Offset="0.0"/>
                                <GradientStop Color="#12A855F7" Offset="0.6"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Border Background="#0B152A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="42" Width="84" Height="84" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <StackPanel x:Name="SplashTextGroup" HorizontalAlignment="Center">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="SplashTextSlide" Y="0"/>
                    </StackPanel.RenderTransform>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding L_SplashTitle}" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#122C4D" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="7" Padding="8,2.5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding L_VersionBadge}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding L_SplashSubtitle}" FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,7,0,18"/>
                    <Border Width="180" Height="4" CornerRadius="2" Background="#121D33" HorizontalAlignment="Center" Padding="2,0">
                        <Border x:Name="SplashProgressFill" Width="0" Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource PrimaryGradientBrush}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
