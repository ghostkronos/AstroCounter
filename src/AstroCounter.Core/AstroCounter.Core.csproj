<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.3.4</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\hipparcos.catalog.gz">
      <WithCulture>false</WithCulture>
      <LogicalName>hipparcos.catalog.gz</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\open_ngc.catalog.gz">
      <WithCulture>false</WithCulture>
      <LogicalName>open_ngc.catalog.gz</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\constellations_88.catalog.gz">
      <WithCulture>false</WithCulture>
      <LogicalName>constellations_88.catalog.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="catalogs\gaia_tycho_dense.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

